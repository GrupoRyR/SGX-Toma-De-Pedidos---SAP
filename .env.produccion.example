# Configuración del servidor (GoDaddy).
#
# Copiar este archivo como `.env` en el servidor y llenar lo que está vacío.
# NO subir este archivo lleno a ningún repositorio ni mandarlo por chat.
#
# Lo que NO está aquí y es a propósito:
#   - DEV_LOGIN: el salto de autenticación de desarrollo. Si no existe, la ruta
#     /dev/entrar ni siquiera se registra. No agregarlo nunca en el servidor.
#   - El buzón remitente del correo: vive en la tabla de configuración y se
#     cambia desde Administración -> Configuración, sin tocar el servidor.

APP_NAME="Pedidos SEGUREX"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pedidos.segurex.com.co

APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Con APP_DEBUG=false, un error muestra una página genérica y el detalle queda
# en storage/logs. Nunca poner true en el servidor: la pantalla de error de
# Laravel muestra variables de entorno, incluido el secreto de Entra ID.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Base de datos: lo que cPanel muestra al crearla.
# El usuario y la base llevan el prefijo de la cuenta de cPanel.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Hosting compartido: sin Redis y sin procesos permanentes.
# Todo va contra la base de datos.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# El correo NO sale por SMTP: GoDaddy suele bloquear los puertos 25, 465 y 587.
# Sale por Microsoft Graph, que viaja por HTTPS. Estas claves quedan sin usar.
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Microsoft Entra ID.
#
# El secreto actual viajó por un chat en texto plano: rotarlo en el portal
# antes de poner esto en producción y pegar aquí el valor nuevo.
# Anotar también la fecha de vencimiento: el día que venza, nadie entra.
# ---------------------------------------------------------------------------
AZURE_CLIENT_ID=a3e52e84-1e6c-45ca-94e7-60a5881b5b5f
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=97cd024c-cd7a-419b-b385-f47b5f5816c8
AZURE_REDIRECT_URI=https://pedidos.segurex.com.co/auth/callback

# Solo entran correos de este dominio, aunque Microsoft autentique a alguien más.
AUTH_DOMINIO_PERMITIDO=segurex.com

# ---------------------------------------------------------------------------
# Numeración de pedidos.
#
# NO puede empezar en 1: en SAP ya hay pedidos de la app vieja con números
# bajos en U_SGX_IdPedidoApp. Confirmar el último número emitido en Power Apps
# y dejar este valor por encima, con margen.
#
# Solo tiene efecto al crear la tabla. Cambiarlo después no renumera nada.
# ---------------------------------------------------------------------------
PEDIDOS_NUMERO_INICIAL=6000
